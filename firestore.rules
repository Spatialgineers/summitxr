rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    // Super admins: the two team accounts, with a verified address or a
    // Google sign-in. An unverified account typed with the same email is not one.
    function isSuperAdmin() {
      return isSignedIn() &&
             request.auth.token.get('email', '') in ['info@spatialgineers.com', 'support@spatialgineers.com'] &&
             (request.auth.token.get('email_verified', false) == true ||
              request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com');
    }

    function isAdmin() {
      return isSuperAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changed() {
      return incoming().diff(existing()).affectedKeys();
    }

    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }

    function optString(data, key, max) {
      return !(key in data) || data[key] == null || isShortString(data[key], max);
    }

    function isBoundedInt(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function optBoundedNumber(data, key, lo, hi) {
      return !(key in data) || ((data[key] is int || data[key] is float) && data[key] >= lo && data[key] <= hi);
    }

    // ---------------------------------------------------------------------
    // Admins & catalogs (read by everyone, written only by admins)
    // ---------------------------------------------------------------------
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 100 &&
             data.role is string && (data.role in ['SUPER_ADMIN', 'DIRECTOR', 'OPERATOR']);
    }

    match /admins/{adminId} {
      // A signed-in user may check whether they themselves are an admin.
      allow get: if isSuperAdmin() || (isSignedIn() && adminId == me());
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow delete: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(tenantId);
    }

    match /questions/{questionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(questionId);
    }

    match /sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(sessionId);
    }

    // Live CMS content (speakers, sessions, sponsors, embeds, map, tiers).
    match /summit_content/{key} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(key) &&
        incoming().keys().hasOnly(['items', 'updatedAt']) &&
        incoming().items is list && incoming().items.size() <= 500;
      allow delete: if isAdmin();
    }

    match /summit_speakers/{speakerId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(speakerId);
    }

    match /summit_sessions/{sessionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(sessionId);
    }

    match /approved_sponsors/{sponsorId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(sponsorId);
    }

    match /gamification_tiers/{tierId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(tierId);
    }

    match /leaderboard_scores/{scoreId} {
      // Retired (the only leaderboard is pilot_leaderboard).
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Site config: feature toggles and the CMS announcement. Admin writes only.
    match /site_config/{configId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(configId) &&
        (configId != 'announcement' || (
          incoming().keys().hasOnly(['id', 'title', 'message', 'priority', 'actionUrl', 'actionLabel', 'at']) &&
          isShortString(incoming().id, 64) &&
          isShortString(incoming().title, 120) &&
          isShortString(incoming().message, 600) &&
          incoming().priority in ['LOW', 'NORMAL', 'HIGH', 'CRITICAL'] &&
          optString(incoming(), 'actionUrl', 300) &&
          optString(incoming(), 'actionLabel', 40) &&
          incoming().at == request.time));
      allow delete: if isAdmin();
    }

    // Admin-only private config (e.g. the Day 3 check-in code). Rules can
    // still read it with get(), which is how check-ins are validated.
    match /summit_private/{docId} {
      allow read, write: if isAdmin();
    }

    // Holo Card roles granted by the team when it approves a speaker or a
    // sponsor. The owner reads their own; only admins write.
    match /credential_grants/{uid} {
      allow get: if isAdmin() || (isSignedIn() && uid == me());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(uid) &&
        incoming().keys().hasOnly(['speaker', 'sponsor', 'updatedAt']) &&
        (!('speaker' in incoming()) || incoming().speaker is map) &&
        (!('sponsor' in incoming()) || incoming().sponsor is map);
      allow delete: if isAdmin();
    }

    // Guild initiates: doc id = their email. Only that person, signed in
    // with that verified address (or Google), can read which initiate they are.
    match /initiate_claims/{email} {
      allow get: if isAdmin() ||
        (isSignedIn() &&
         request.auth.token.get('email', '').lower() == email &&
         (request.auth.token.get('email_verified', false) == true ||
          request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com'));
      allow list: if isAdmin();
      allow create, update: if isAdmin() && email.size() <= 150 &&
        incoming().keys().hasOnly(['initiateId', 'updatedAt']) &&
        isShortString(incoming().initiateId, 128);
      allow delete: if isAdmin();
    }

    match /telemetry_events/{eventId} {
      allow read, write: if isAdmin();
    }

    match /telemetry_aggregates/{aggId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Registrations & inquiries (visitors create, the team reads)
    // ---------------------------------------------------------------------
    function isValidTicketInquiry(data) {
      return data.keys().hasOnly(['email', 'ticketType', 'fullName', 'roleTitle', 'organization', 'referenceCode',
                                  'status', 'userId', 'timestamp', 'imageConsent', 'consentAt']) &&
             data.keys().hasAll(['email', 'ticketType']) &&
             isShortString(data.email, 150) && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
             data.ticketType in ['DIGITAL', 'SHOWCASE_PHYSICAL'] &&
             optString(data, 'fullName', 100) &&
             optString(data, 'roleTitle', 100) &&
             optString(data, 'organization', 150) &&
             optString(data, 'referenceCode', 100) &&
             (!('status' in data) || data.status == 'PENDING') &&
             (!('userId' in data) || data.userId == null || (isSignedIn() && data.userId == me())) &&
             (!('imageConsent' in data) || data.imageConsent is bool) &&
             (!('consentAt' in data) || data.consentAt is int) &&
             (!('timestamp' in data) || data.timestamp == request.time);
    }

    // Emails sent by the Apps Script mailer (info@, IAM credentials: rules do not apply to it).
    // Admins read the log to see who got which email; nobody writes it from the app.
    match /mail_log/{logId} {
      allow get, list: if isAdmin();
    }

    match /ticket_inquiries/{inquiryId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == me());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == me());
      allow create: if isValidTicketInquiry(incoming());
      // Team: invitation status. Owner (same signed-in uid): edit their own details and consent, never the status.
      allow update: if (isAdmin() &&
          changed().hasOnly(['status', 'invitedAt', 'notes']) &&
          incoming().status in ['PENDING', 'INVITED', 'CONFIRMED', 'DECLINED'] &&
          optString(incoming(), 'notes', 500)) ||
        (isSignedIn() && resource.data.userId == me() && incoming().userId == me() &&
          changed().hasOnly(['email', 'ticketType', 'fullName', 'roleTitle', 'organization', 'imageConsent', 'consentAt', 'timestamp']) &&
          isShortString(incoming().email, 150) &&
          incoming().ticketType in ['DIGITAL', 'SHOWCASE_PHYSICAL'] &&
          optString(incoming(), 'fullName', 100) &&
          optString(incoming(), 'roleTitle', 100) &&
          optString(incoming(), 'organization', 150) &&
          (!('imageConsent' in incoming()) || incoming().imageConsent is bool) &&
          (!('consentAt' in incoming()) || incoming().consentAt is int) &&
          incoming().timestamp == request.time);
      allow delete: if isAdmin();
    }

    function isValidSponsorInquiry(id, data) {
      return data.keys().hasOnly(['id', 'companyName', 'contactName', 'roleTitle', 'email', 'phone', 'websiteUrl',
                                  'selectedTierId', 'selectedTierName', 'estimatedBudget', 'goals', 'customMessage',
                                  'submittedAt', 'status', 'referenceCode', 'submittedBy']) &&
             data.keys().hasAll(['id', 'companyName', 'contactName', 'email', 'selectedTierId']) &&
             data.id == id &&
             isShortString(data.companyName, 120) && data.companyName.size() > 0 &&
             isShortString(data.contactName, 100) && data.contactName.size() > 0 &&
             isShortString(data.email, 150) &&
             isShortString(data.selectedTierId, 50) &&
             optString(data, 'roleTitle', 100) &&
             optString(data, 'phone', 40) &&
             optString(data, 'websiteUrl', 300) &&
             optString(data, 'selectedTierName', 150) &&
             optString(data, 'estimatedBudget', 60) &&
             optString(data, 'customMessage', 2000) &&
             optString(data, 'referenceCode', 60) &&
             (!('goals' in data) || (data.goals is list && data.goals.size() <= 12)) &&
             (!('submittedAt' in data) || data.submittedAt is int) &&
             (!('status' in data) || data.status == 'PENDING_REVIEW') &&
             (!('submittedBy' in data) || (isSignedIn() && data.submittedBy == me()));
    }

    match /sponsor_inquiries/{inquiryId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(inquiryId) && isValidSponsorInquiry(inquiryId, incoming());
      allow update, delete: if isAdmin();
    }

    // Speaker portal self-registrations: the team reviews and publishes them.
    match /speaker_submissions/{speakerId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(speakerId) &&
        incoming().keys().hasOnly(['id', 'name', 'handle', 'role', 'organization', 'avatarUrl', 'bio', 'pillarId', 'day',
                                   'isKeynote', 'isAwakenInitiate', 'awakenRank', 'socialLinks', 'submittedAt', 'submittedBy']) &&
        isShortString(incoming().name, 100) && incoming().name.size() > 0 &&
        optString(incoming(), 'role', 100) &&
        optString(incoming(), 'organization', 150) &&
        optString(incoming(), 'handle', 60) &&
        optString(incoming(), 'bio', 3000) &&
        optString(incoming(), 'avatarUrl', 900000) &&
        (!('day' in incoming()) || (incoming().day is int && incoming().day >= 1 && incoming().day <= 3)) &&
        (!('isKeynote' in incoming()) || incoming().isKeynote == false) &&
        (!('socialLinks' in incoming()) || incoming().socialLinks is map) &&
        incoming().submittedAt == request.time &&
        (incoming().submittedBy == null || (isSignedIn() && incoming().submittedBy == me()));
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Players & pilots (each person writes only their own document)
    // ---------------------------------------------------------------------
    function isValidPlayer(data) {
      return data.keys().hasAll(['uid', 'username', 'tenantId', 'eventId']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.username is string && data.username.size() <= 80 &&
             data.tenantId is string && data.tenantId.size() <= 100 &&
             data.eventId is string && data.eventId.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150));
    }

    match /players/{playerId} {
      // Holds emails: owner and admins only.
      allow get: if (isSignedIn() && playerId == me()) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if (isSignedIn() && playerId == me() && isValidId(playerId) &&
                                incoming().uid == playerId && isValidPlayer(incoming())) || isAdmin();
      allow delete: if isAdmin();
    }

    match /pilot_profiles/{profileId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && profileId == me() &&
        incoming().keys().hasOnly(['uid', 'nickname', 'callsign', 'avatarSeed', 'avatarColor', 'level', 'totalXp', 'rankTitle',
                                   'createdAt', 'lastActive', 'weekendStats', 'weekendActivity', 'droneStats', 'achievements',
                                   'selectedRole', 'unlockedCapsules', 'matchBio', 'matchRoles', 'matchIndustries', 'updatedAt']) &&
        incoming().uid == me() &&
        isShortString(incoming().nickname, 60) &&
        optString(incoming(), 'callsign', 30) &&
        optString(incoming(), 'avatarSeed', 80) &&
        optString(incoming(), 'avatarColor', 20) &&
        optString(incoming(), 'rankTitle', 60) &&
        optString(incoming(), 'matchBio', 500) &&
        isBoundedInt(incoming().totalXp, 0, 100000) &&
        isBoundedInt(incoming().level, 0, 1000) &&
        (!('weekendActivity' in incoming()) || (incoming().weekendActivity is list && incoming().weekendActivity.size() <= 50)) &&
        (!('achievements' in incoming()) || (incoming().achievements is list && incoming().achievements.size() <= 40));
      allow delete: if isAdmin() || (isSignedIn() && profileId == me());
    }

    match /pilot_leaderboard/{pilotId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && pilotId == me() &&
        incoming().keys().hasOnly(['uid', 'nickname', 'avatarSeed', 'avatarColor', 'rankTitle', 'level', 'totalXp',
                                   'droneHighScore', 'totalTricks', 'connectionsCount', 'votesCount', 'updatedAt']) &&
        incoming().uid == me() &&
        isShortString(incoming().nickname, 60) &&
        optString(incoming(), 'avatarSeed', 80) &&
        optString(incoming(), 'avatarColor', 20) &&
        optString(incoming(), 'rankTitle', 60) &&
        isBoundedInt(incoming().totalXp, 0, 100000) &&
        isBoundedInt(incoming().level, 0, 1000) &&
        optBoundedNumber(incoming(), 'droneHighScore', 0, 10000000) &&
        optBoundedNumber(incoming(), 'totalTricks', 0, 100000) &&
        optBoundedNumber(incoming(), 'connectionsCount', 0, 5000) &&
        optBoundedNumber(incoming(), 'votesCount', 0, 5000);
      allow delete: if isAdmin() || (isSignedIn() && pilotId == me());
    }

    // ---------------------------------------------------------------------
    // Rewards: catalog by admins; a pilot's voucher and the inventory step
    // must be written together in one batch.
    // ---------------------------------------------------------------------
    match /gamification_rewards/{rewardId} {
      allow get, list: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        changed().hasOnly(['claimedCount', 'inventoryCount', 'lastClaimId', 'updatedAt']) &&
        incoming().claimedCount == existing().claimedCount + 1 &&
        // -1 = unlimited stock (count unchanged); otherwise there must be stock and it steps down by one.
        ((existing().inventoryCount == -1 && incoming().inventoryCount == -1) ||
          (existing().inventoryCount > 0 && incoming().inventoryCount == existing().inventoryCount - 1)) &&
        (!('isActive' in existing()) || existing().isActive != false) &&
        (!('active' in existing()) || existing().active != false) &&
        incoming().lastClaimId == rewardId + '_' + me() &&
        !exists(/databases/$(database)/documents/redeemed_prizes/$(rewardId + '_' + me())) &&
        existsAfter(/databases/$(database)/documents/redeemed_prizes/$(rewardId + '_' + me())));
    }

    match /redeemed_prizes/{redemptionId} {
      // Vouchers carry the pilot's name and email: owner and admins only.
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == me());
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly(['id', 'rewardId', 'rewardTitle', 'category', 'userId', 'userEmail', 'userName',
                                   'voucherCode', 'xpSpent', 'claimedAt', 'accessUrl', 'qrPayload', 'status']) &&
        incoming().userId == me() &&
        incoming().id == redemptionId &&
        redemptionId == incoming().rewardId + '_' + me() &&
        incoming().status == 'ACTIVE' &&
        isShortString(incoming().voucherCode, 60) &&
        optString(incoming(), 'userEmail', 150) &&
        optString(incoming(), 'userName', 100) &&
        optString(incoming(), 'rewardTitle', 200) &&
        optString(incoming(), 'accessUrl', 500) &&
        optString(incoming(), 'qrPayload', 1000) &&
        getAfter(/databases/$(database)/documents/gamification_rewards/$(incoming().rewardId)).data.lastClaimId == redemptionId;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Chat & social wall
    // ---------------------------------------------------------------------
    // A reaction adds exactly +1 to exactly one emoji.
    function reactionsBefore() {
      return existing().get('reactions', {});
    }

    // Same emoji set the chat offers. Each one may stay the same or go up by exactly 1.
    function reactionEmojis() {
      return ['🔥', '🚀', '👏', '💎', '❤️', '💡', '🙌', '😂'];
    }

    function emojiStepOk(e) {
      return incoming().reactions.get(e, 0) == reactionsBefore().get(e, 0) ||
             incoming().reactions.get(e, 0) == reactionsBefore().get(e, 0) + 1;
    }

    function isOneReactionStep() {
      return incoming().reactions.diff(reactionsBefore()).affectedKeys().size() == 1 &&
             incoming().reactions.diff(reactionsBefore()).affectedKeys().hasOnly(reactionEmojis()) &&
             emojiStepOk('🔥') && emojiStepOk('🚀') && emojiStepOk('👏') && emojiStepOk('💎') &&
             emojiStepOk('❤️') && emojiStepOk('💡') && emojiStepOk('🙌') && emojiStepOk('😂');
    }

    match /chat_messages/{messageId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly(['channelId', 'senderId', 'authorUid', 'senderName', 'senderAvatar', 'senderRole',
                                   'senderPillar', 'text', 'timestamp', 'reactions', 'isPinned']) &&
        incoming().authorUid == me() &&
        incoming().senderId == me() &&
        isShortString(incoming().channelId, 60) &&
        isShortString(incoming().senderName, 100) && incoming().senderName.size() > 0 &&
        isShortString(incoming().text, 1000) && incoming().text.size() > 0 &&
        (!('senderAvatar' in incoming()) || (isShortString(incoming().senderAvatar, 1000) && incoming().senderAvatar.matches('^https://.*'))) &&
        (!('senderRole' in incoming()) || incoming().senderRole == 'ATTENDEE' || isAdmin()) &&
        optString(incoming(), 'senderPillar', 50) &&
        (!('timestamp' in incoming()) || incoming().timestamp is int) &&
        (!('reactions' in incoming()) || (incoming().reactions is map && incoming().reactions.size() == 0)) &&
        (!('isPinned' in incoming()) || incoming().isPinned == false || isAdmin());
      // Anyone signed in can add a reaction; only admins pin or moderate.
      allow update: if isAdmin() || (
        isSignedIn() &&
        changed().hasOnly(['reactions']) &&
        incoming().reactions is map && incoming().reactions.size() <= 12 &&
        isOneReactionStep());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == me());
    }

    match /social_posts/{postId} {
      allow get, list: if true;
      allow create: if isValidId(postId) && isSignedIn() && (isAdmin() || (
        incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 2000 &&
        incoming().createdAt is int &&
        incoming().platform is string && incoming().platform.size() <= 30 &&
        incoming().authorUid == me() &&
        incoming().author is map &&
        incoming().author.verified == false &&
        incoming().likes == 0 && incoming().commentsCount == 0 && incoming().sharesCount == 0 &&
        incoming().comments is list && incoming().comments.size() == 0 &&
        incoming().isFeaturedOnStage == false));
      allow update: if isAdmin() || (
        isSignedIn() && (
          (changed().hasOnly(['likes']) && incoming().likes == existing().likes + 1) ||
          (changed().hasOnly(['comments', 'commentsCount']) &&
            incoming().commentsCount == existing().commentsCount + 1 &&
            incoming().comments is list &&
            incoming().comments.size() == existing().comments.size() + 1 &&
            incoming().comments.size() <= 300)));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == me());
    }

    // ---------------------------------------------------------------------
    // SGX.Match: public, email-free cards; intents and matches are private
    // to the two people involved.
    // ---------------------------------------------------------------------
    match /match_profiles/{profileId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || (
        isSignedIn() && profileId == me() &&
        incoming().keys().hasOnly(['uid', 'displayName', 'organization', 'roleTitle', 'avatarSeed', 'profile', 'updatedAt']) &&
        incoming().uid == me() &&
        isShortString(incoming().displayName, 80) &&
        optString(incoming(), 'organization', 120) &&
        optString(incoming(), 'roleTitle', 80) &&
        optString(incoming(), 'avatarSeed', 80) &&
        incoming().profile is map &&
        isShortString(incoming().profile.pitch, 120));
      allow delete: if isAdmin() || (isSignedIn() && profileId == me());
    }

    match /match_intents/{intentId} {
      // Missing docs read as "no intent" so the reciprocity check works.
      allow get: if isSignedIn() && (resource == null || resource.data.fromUid == me() || resource.data.toUid == me());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly(['id', 'fromUid', 'toUid', 'createdAt']) &&
        incoming().fromUid == me() &&
        isValidId(incoming().toUid) && incoming().toUid != me() &&
        intentId == me() + '_' + incoming().toUid &&
        incoming().id == intentId;
      allow update: if false;
      allow delete: if isAdmin();
    }

    function isMatchMember(data) {
      return isSignedIn() && (data.userA == me() || data.userB == me());
    }

    match /matches/{matchId} {
      allow get: if isAdmin() || (resource != null && isMatchMember(resource.data));
      allow list: if isAdmin();
      // A match exists only when both people sent an intent.
      allow create: if isMatchMember(incoming()) &&
        incoming().keys().hasOnly(['id', 'userA', 'userB', 'createdAt', 'xpAwarded', 'notes']) &&
        incoming().userA < incoming().userB &&
        matchId == incoming().userA + '__' + incoming().userB &&
        incoming().id == matchId &&
        exists(/databases/$(database)/documents/match_intents/$(incoming().userA + '_' + incoming().userB)) &&
        exists(/databases/$(database)/documents/match_intents/$(incoming().userB + '_' + incoming().userA));
      allow update: if isAdmin() || (isMatchMember(existing()) && changed().hasOnly(['createdAt', 'xpAwarded']));
      allow delete: if isAdmin();
    }

    match /match_passes/{passId} {
      allow get: if isAdmin() || (isSignedIn() && resource != null && resource.data.fromUid == me());
      allow list: if isAdmin();
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly(['id', 'fromUid', 'toUid', 'createdAt']) &&
        incoming().fromUid == me() &&
        passId == me() + '_' + incoming().toUid &&
        incoming().id == passId;
      allow delete: if isAdmin();
    }

    match /match_reports/{reportId} {
      allow create: if isSignedIn() && isValidId(reportId) &&
        incoming().keys().hasOnly(['id', 'fromUid', 'targetUid', 'reason', 'createdAt']) &&
        incoming().fromUid == me() &&
        isShortString(incoming().reason, 500);
      allow get, list, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Keynote polls: one vote per pilot per poll, counts are public.
    // ---------------------------------------------------------------------
    match /summit_poll_votes/{voteId} {
      allow get, list: if true;
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly(['pollId', 'optionId', 'uid', 'at']) &&
        isShortString(incoming().pollId, 64) && incoming().pollId.matches('^[a-z0-9_]+$') &&
        isShortString(incoming().optionId, 64) && incoming().optionId.size() > 0 &&
        incoming().uid == me() &&
        voteId == incoming().pollId + '_' + me() &&
        incoming().at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // SGX Visit Radar: public counters. Anyone can read them; a write can only
    // add exactly one visit (and at most one unique visitor). No IPs or exact
    // locations are stored, only the coarse region.
    // ---------------------------------------------------------------------
    function isCountStep(field) {
      return incoming()[field] is int &&
             (resource == null
               ? (incoming()[field] == 0 || incoming()[field] == 1)
               : (incoming()[field] == existing()[field] || incoming()[field] == existing()[field] + 1));
    }

    function isVisitStep() {
      return incoming().totalVisits is int &&
             (resource == null ? incoming().totalVisits == 1 : incoming().totalVisits == existing().totalVisits + 1) &&
             isCountStep('uniqueVisitors');
    }

    match /summit_visit_stats/{statId} {
      allow get, list: if true;
      allow create, update: if statId == 'global' &&
        incoming().keys().hasOnly(['totalVisits', 'uniqueVisitors', 'updatedAt']) &&
        incoming().updatedAt == request.time &&
        isVisitStep();
      allow delete: if isAdmin();
    }

    match /summit_visit_regions/{regionId} {
      allow get, list: if true;
      // Region names are plain place names: letters (accents included), digits,
      // spaces and . , ' - ( ). No markup can get in.
      allow create: if isValidId(regionId) && regionId.size() <= 64 &&
        incoming().keys().hasOnly(['name', 'kind', 'country', 'lat', 'lon', 'totalVisits', 'uniqueVisitors', 'lastVisitAt']) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 80 &&
        incoming().name.matches("^[A-Za-z0-9À-ÿ .,'()\\-]+$") &&
        incoming().kind in ['municipio', 'state', 'country', 'unknown'] &&
        incoming().country is string && incoming().country.size() <= 4 && incoming().country.matches('^[A-Za-z]*$') &&
        (incoming().lat == null || incoming().lat is number) &&
        (incoming().lon == null || incoming().lon is number) &&
        incoming().lastVisitAt == request.time &&
        isVisitStep();
      allow update: if isValidId(regionId) &&
        changed().hasOnly(['totalVisits', 'uniqueVisitors', 'lastVisitAt']) &&
        incoming().lastVisitAt == request.time &&
        isVisitStep();
      allow delete: if isAdmin();
    }

    match /summit_visitors/{visitorId} {
      allow get: if isValidId(visitorId);
      allow list: if isAdmin();
      allow create: if isValidId(visitorId) &&
        incoming().keys().hasOnly(['regionId', 'createdAt']) &&
        incoming().regionId is string && incoming().regionId.size() <= 64 &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // SGX Pass. Mutual Rolodex: whoever scans a pass drops their own card in
    // the owner's inbox (one doc per pair, create-only). Only the owner can
    // read their inbox. No emails travel here, only what the pass QR shows.
    // ---------------------------------------------------------------------
    match /summit_pass_exchanges/{pairId} {
      allow get, list: if isSignedIn() && resource.data.toUid == me();
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly(['toUid', 'fromUid', 'card', 'at']) &&
        incoming().fromUid == me() &&
        isValidId(incoming().toUid) &&
        incoming().toUid != me() &&
        pairId == incoming().toUid + '_' + me() &&
        incoming().at == request.time &&
        incoming().card is map &&
        incoming().card.keys().hasOnly(['c', 'n', 's', 'p', 'r', 'o']) &&
        isShortString(incoming().card.c, 40) && incoming().card.c.size() > 0 &&
        isShortString(incoming().card.n, 80) && incoming().card.n.size() > 0 &&
        isShortString(incoming().card.s, 20) &&
        incoming().card.p in ['', 'STORY', 'SHOWCASE', 'SPARK', 'STAGE', 'SYSTEM', 'SYNTHESIZE'] &&
        isShortString(incoming().card.r, 80) &&
        isShortString(incoming().card.o, 80);
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.toUid == me());
    }

    // Public networking board: only counts (stars, pillars linked), never who the contacts are.
    match /summit_constellations/{uid} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && uid == me() &&
        incoming().keys().hasOnly(['callsign', 'name', 'affinity', 'stars', 'pillars', 'updatedAt']) &&
        isShortString(incoming().callsign, 20) &&
        isShortString(incoming().name, 40) &&
        incoming().affinity in ['', 'STORY', 'SHOWCASE', 'SPARK', 'STAGE', 'SYSTEM', 'SYNTHESIZE'] &&
        incoming().stars is int && incoming().stars >= 0 && incoming().stars <= 500 &&
        incoming().pillars is list && incoming().pillars.size() <= 6 &&
        incoming().pillars.hasOnly(['STORY', 'SHOWCASE', 'SPARK', 'STAGE', 'SYSTEM', 'SYNTHESIZE']) &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() || (isSignedIn() && uid == me());
    }

    // Day 3 entrance at Chroma Space Studios (Dec 13 2026, Puerto Rico time).
    // The door code travels in a private proof written in the same batch and
    // must match summit_private/checkin, which no visitor can read.
    function isDay3Window() {
      return request.time >= timestamp.value('2026-12-13T04:00:00Z') &&
             request.time <= timestamp.value('2026-12-14T10:00:00Z');
    }

    match /summit_checkin_proofs/{uid} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && uid == me() && isDay3Window() &&
        incoming().keys().hasOnly(['code', 'at']) &&
        incoming().at == request.time &&
        incoming().code == get(/databases/$(database)/documents/summit_private/checkin).data.code;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Public (coarse region only) so the radar can light municipios; one per device.
    match /summit_checkins/{uid} {
      allow get, list: if true;
      allow create: if isSignedIn() && uid == me() && isDay3Window() &&
        incoming().keys().hasOnly(['regionId', 'regionName', 'at']) &&
        isShortString(incoming().regionId, 64) &&
        isShortString(incoming().regionName, 80) &&
        incoming().at == request.time &&
        existsAfter(/databases/$(database)/documents/summit_checkin_proofs/$(me()));
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
